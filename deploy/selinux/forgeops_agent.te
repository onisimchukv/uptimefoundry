policy_module(forgeops_agent, 1.3.0)

########################################
#
# Declarations
#

# Supervisor Domain
type forgeops_agent_t;
type forgeops_agent_exec_t;
init_daemon_domain(forgeops_agent_t, forgeops_agent_exec_t)

# Discovery Helper Domain
type forgeops_agent_discovery_t;
type forgeops_agent_discovery_exec_t;
init_daemon_domain(forgeops_agent_discovery_t, forgeops_agent_discovery_exec_t)

# eBPF Worker Domain
type forgeops_agent_ebpf_t;
type forgeops_agent_ebpf_exec_t;
init_daemon_domain(forgeops_agent_ebpf_t, forgeops_agent_ebpf_exec_t)

# Actuator Domain (A5)
type forgeops_agent_actuator_t;
type forgeops_agent_actuator_exec_t;
init_daemon_domain(forgeops_agent_actuator_t, forgeops_agent_actuator_exec_t)

# Configuration File Type
type forgeops_agent_conf_t;
files_type(forgeops_agent_conf_t)

# State, WAL and Identity Directory Type
type forgeops_agent_var_lib_t;
files_type(forgeops_agent_var_lib_t)

# Runtime Sockets Type
type forgeops_agent_var_run_t;
files_type(forgeops_agent_var_run_t)

########################################
#
# Supervisor Policy (forgeops_agent_t)
#

# Access config files (read-only)
allow forgeops_agent_t forgeops_agent_conf_t:dir list_dir_perms;
allow forgeops_agent_t forgeops_agent_conf_t:file read_file_perms;

# Access state, WAL, and identity
manage_dirs_pattern(forgeops_agent_t, forgeops_agent_var_lib_t, forgeops_agent_var_lib_t)
manage_files_pattern(forgeops_agent_t, forgeops_agent_var_lib_t, forgeops_agent_var_lib_t)

# Runtime sockets (/run/forgeops-agent/agent.sock)
manage_dirs_pattern(forgeops_agent_t, forgeops_agent_var_run_t, forgeops_agent_var_run_t)
manage_sock_files_pattern(forgeops_agent_t, forgeops_agent_var_run_t, forgeops_agent_var_run_t)

# Outbound Network: Supervisor is allowed outbound TCP to control plane
sysnet_dns_name_resolve(forgeops_agent_t)
corenet_tcp_connect_http(forgeops_agent_t)
corenet_tcp_connect_all_ports(forgeops_agent_t)

# Zero capability rule for supervisor
dontaudit forgeops_agent_t self:capability *;

########################################
#
# eBPF Worker Policy (forgeops_agent_ebpf_t)
#

# eBPF & Perfmon Permissions
allow forgeops_agent_ebpf_t self:bpf { map_create map_read map_write prog_load prog_run };
allow forgeops_agent_ebpf_t self:perfmon { cpu open tracepoint kernel read write };
allow forgeops_agent_ebpf_t self:capability { bpf perfmon net_admin sys_ptrace };

# Sockets: AF_UNIX for IPC to supervisor, AF_NETLINK for socket tracking
allow forgeops_agent_ebpf_t self:unix_stream_socket create_stream_socket_perms;
allow forgeops_agent_ebpf_t self:netlink_route_socket create_netlink_socket_perms;
allow forgeops_agent_ebpf_t forgeops_agent_var_run_t:sock_file write;
allow forgeops_agent_ebpf_t forgeops_agent_t:unix_stream_socket connectto;

# Strict Network Isolation: eBPF worker is DENIED network socket creation
neverallow forgeops_agent_ebpf_t self:tcp_socket *;
neverallow forgeops_agent_ebpf_t self:udp_socket *;

# Read BTF and /proc
kernel_read_system_state(forgeops_agent_ebpf_t)
kernel_read_proc_symlinks(forgeops_agent_ebpf_t)

########################################
#
# Discovery Helper Policy (forgeops_agent_discovery_t)
#

# Read /proc, /sys, /etc for host inventory
kernel_read_system_state(forgeops_agent_discovery_t)
files_read_etc_files(forgeops_agent_discovery_t)
allow forgeops_agent_discovery_t self:unix_stream_socket create_stream_socket_perms;
allow forgeops_agent_discovery_t forgeops_agent_t:unix_stream_socket connectto;

# Never allow network sockets
neverallow forgeops_agent_discovery_t self:tcp_socket *;
neverallow forgeops_agent_discovery_t self:udp_socket *;
