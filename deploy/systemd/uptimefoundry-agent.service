[Unit]
Description=UptimeFoundry Host Agent Supervisor
Documentation=https://github.com/onisimchukv/uptimefoundry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uptimefoundry-agent
Group=uptimefoundry-agent
ExecStart=/usr/bin/uptimefoundry-agent --config /etc/uptimefoundry-agent/policy.yaml
Restart=on-failure
RestartSec=5s

# Security Hardening (Specification v1.3 Section 13.2)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=read-only
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictNamespaces=yes

# Privilege Minimization: Supervisor holds zero capabilities
CapabilityBoundingSet=
AmbientCapabilities=

# Network Restrictions: Supervisor needs outbound TCP to control plane and AF_UNIX for IPC
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# System Call Filtering
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @clock @raw-io
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# Filesystem Access
ReadWritePaths=/var/lib/uptimefoundry-agent /run/uptimefoundry-agent
ReadOnlyPaths=/etc/uptimefoundry-agent

# Resource Budgets (Section 11.1)
CPUQuota=2%
MemoryHigh=48M
MemoryMax=64M

[Install]
WantedBy=multi-user.target
