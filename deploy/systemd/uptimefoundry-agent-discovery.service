[Unit]
Description=UptimeFoundry Host Agent Discovery Worker
Documentation=https://github.com/onisimchukv/uptimefoundry
BindsTo=uptimefoundry-agent.service
After=uptimefoundry-agent.service

[Service]
Type=simple
User=uptimefoundry-agent-disc
Group=uptimefoundry-agent
ExecStart=/usr/libexec/uptimefoundry-agent/uptimefoundry-agent-discovery
Restart=on-failure
RestartSec=5s

# Security Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=read-only
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictNamespaces=yes

# Discovery worker has zero capabilities
CapabilityBoundingSet=
AmbientCapabilities=

# No TCP or outbound networking; AF_UNIX only
RestrictAddressFamilies=AF_UNIX

# Read-only host inventory access
ReadOnlyPaths=/proc /sys /etc
ReadWritePaths=/run/uptimefoundry-agent

# Resource Budgets (Section 11.1)
CPUQuota=5%
MemoryHigh=48M
MemoryMax=64M

[Install]
WantedBy=uptimefoundry-agent.service
