[Unit]
Description=ForgeOps Host Agent Discovery Worker
Documentation=https://github.com/forgeops/forgeops
BindsTo=forgeops-agent.service
After=forgeops-agent.service

[Service]
Type=simple
User=forgeops-agent-disc
Group=forgeops-agent
ExecStart=/usr/libexec/forgeops-agent/forgeops-agent-discovery
Restart=on-failure
RestartSec=5s

# Security Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=read-only
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictNamespaces=yes

# Discovery worker has zero capabilities
CapabilityBoundingSet=
AmbientCapabilities=

# No TCP or outbound networking; AF_UNIX only
RestrictAddressFamilies=AF_UNIX

# Read-only host inventory access
ReadOnlyPaths=/proc /sys /etc
ReadWritePaths=/run/forgeops-agent

# Resource Budgets (Section 11.1)
CPUQuota=5%
MemoryHigh=48M
MemoryMax=64M

[Install]
WantedBy=forgeops-agent.service
